# ============================================================
#  绝不入库：本地凭据与运行产物
# ============================================================
# 真实账号 Cookie / token / 推送 key 都在这里，提交等于把账号送人
config.json

# 运行日志 + 设备指纹 + 森空岛 cred 缓存，全部含隐私
logs/

# 每日完成情况存档（本机数据，不属于代码）
data/

# 扫码登录落盘的二维码（含 ticket）
qr_login.png

# ============================================================
#  本机专属部署脚本：含绝对路径与本机用户名
# ============================================================
# 注意：必须写成 /run.bat（只匹配根目录），否则会误伤其它目录下的同名文件
/run.bat
/fix_task.bat
/fix_task_bg.bat
/task_gamedaily.xml

# ============================================================
#  手机端 APK（5MB 二进制，放本地 tools/ 供扫码下载，不进版本库）
# ============================================================
tools/*.apk

# ============================================================
#  构建产物
# ============================================================
release/
dist/
build/
*.zip

# ============================================================
#  对话 / 工具记忆（含大量调试细节与账号信息）
# ============================================================
.workbuddy/

# ============================================================
#  Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.coverage

# ============================================================
#  编辑器 / 系统
# ============================================================
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
*.log

# ============================================================
#  本地备份 / 测试临时产物（第三阶段清理）
# ============================================================
# 各环节的手工备份快照（含凭证，绝不入库）
*.bak
*.bak-*

# 测试临时文件（真正的测试资产在 tests/，见下方否定规则）
rl_script.js
rl_hist_payload.json
live_page_check.html
start.bat.lnk
rl_test_*
!tests/
!tests/**
# 但 tests/ 里的手工备份快照仍要忽略：上面的 !tests/** 会重新放行全部内容，
# 其中包含 *.bak-*，不能让含凭证的备份跟着测试一起入库。
tests/**/*.bak
tests/**/*.bak-*
# 同理：!tests/** 会放行测试运行产生的字节码缓存，显式压回去
tests/**/__pycache__/

# ============================================================
#  exe 化工程（C# 壳 + Python 引擎）
# ============================================================
# engine/ 是构建产物：便携 Python + 项目代码副本，全部可由脚本重建
/engine/
# 构建过程的临时下载物
/build_pyembed.zip
/build_wheels/

# C# 壳构建产物（本地测试用，正式发布走 release/）
/ResinLoop.exe
/WebView2Loader.dll
/Microsoft.Web.WebView2.Core.dll
/Microsoft.Web.WebView2.WinForms.dll
/build_ilrepack/
/build_ilrepack.zip

# shell 构建目录（正式产物只保留源码与图标）
/shell/bin/
/shell/obj/
/shell/publish/
/shell/.tools/
